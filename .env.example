# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google Cloud OAuth credentials. Add http://localhost:3000/api/auth/callback/google
# as an authorized redirect URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional override used in deployed environments.
AUTH_URL=http://localhost:3000
# Local development only. Never expose this as NEXT_PUBLIC_*.
BILL_MOSHI_DEVELOPER_PASSWORD=

# Persistent directory for invitation approvals and Group-deletion authority.
# Use an absolute path on hosts with an ephemeral application filesystem.
BILL_MOSHI_DATA_DIR=
